<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Imagenes\beneficiarios.png" />
    <None Remove="Imagenes\configuracion.png" />
    <None Remove="Imagenes\dashboard.png" />
    <None Remove="Imagenes\logo.png" />
    <None Remove="Imagenes\mapa.png" />
    <None Remove="Imagenes\personas.png" />
    <None Remove="Imagenes\usuario.png" />
    <None Remove="Ventanas\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Imagenes\beneficiarios.png" />
    <Resource Include="Imagenes\configuracion.png" />
    <Resource Include="Imagenes\dashboard.png" />
    <Resource Include="Imagenes\logo.png" />
    <Resource Include="Imagenes\mapa.png" />
    <Resource Include="Imagenes\personas.png" />
    <Resource Include="Imagenes\usuario.png" />
    <Resource Include="Ventanas\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Página del Mapa de Riesgo (se sirve desde la carpeta de salida como https://habitar.local/) -->
    <None Update="Mapa\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- URL del servidor (ApiUrl) -->
    <None Update="config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
