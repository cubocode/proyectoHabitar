<Window x:Class="proyectoHabitar.Ventanas.FormUsuarioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datos del Usuario" Height="550" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#1E293B">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblTitulo" Text="Nuevo Usuario" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Nombre de Usuario" Foreground="#94A3B8" Margin="0,5,0,3" FontWeight="SemiBold"/>
                <TextBox x:Name="txtUsuario" Background="#0F172A" Foreground="White" BorderBrush="#334155" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>

                <StackPanel x:Name="PanelContrasena">
                    <TextBlock Text="Contraseña" Foreground="#94A3B8" Margin="0,10,0,3" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="txtPassword" Background="#0F172A" Foreground="White" BorderBrush="#334155" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>
                </StackPanel>

                <TextBlock Text="Nombre" Foreground="#94A3B8" Margin="0,10,0,3" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNombre" Background="#0F172A" Foreground="White" BorderBrush="#334155" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Apellido" Foreground="#94A3B8" Margin="0,10,0,3" FontWeight="SemiBold"/>
                <TextBox x:Name="txtApellido" Background="#0F172A" Foreground="White" BorderBrush="#334155" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="DNI" Foreground="#94A3B8" Margin="0,10,0,3" FontWeight="SemiBold"/>
                <TextBox x:Name="txtDni" Background="#0F172A" Foreground="White" BorderBrush="#334155" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Email" Foreground="#94A3B8" Margin="0,10,0,3" FontWeight="SemiBold"/>
                <TextBox x:Name="txtEmail" Background="#0F172A" Foreground="White" BorderBrush="#334155" Height="30" VerticalContentAlignment="Center" Padding="5,0"/>

                <TextBlock Text="Rol / Perfil" Foreground="#94A3B8" Margin="0,10,0,3" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbRol" Background="#0F172A" Height="30" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Administrador"/>
                    <ComboBoxItem Content="Encuestador"/>
                    <ComboBoxItem Content="Logística"/>
                </ComboBox>

                <StackPanel x:Name="PanelActivo" Visibility="Collapsed" Margin="0,15,0,0">
                    <CheckBox x:Name="chkActivo" Content="Usuario Activo" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancelar" Content="Cancelar" Width="90" Height="32" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="btnCancelar_Click"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="100" Height="32" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="btnGuardar_Click"/>
        </StackPanel>
    </Grid>
</Window>