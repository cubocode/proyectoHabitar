<UserControl x:Class="proyectoHabitar.Ventanas.UC_Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:proyectoHabitar.Ventanas"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <Grid Background="#F5F6F8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25">
                <TextBlock Text="Dashboard General" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,2"/>
                <TextBlock Text="Panel de control e indicadores en tiempo real del Sistema HabitAR" FontSize="13" Foreground="#64748B" Margin="0,0,0,25"/>

                <UniformGrid Columns="4" Margin="0,0,0,25">
                    <Border Background="White" CornerRadius="8" Margin="0,0,12,0" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Total Censados" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="lblTotalCensados" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="0,5"/>
                            <TextBlock Text="Padrón general" FontSize="11" Foreground="#10B981" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="8" Margin="0,0,12,0" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Prioridad Alta (Rojo)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="lblVulnerabilidadAlta" Text="0" FontSize="22" FontWeight="Bold" Foreground="#EF4444" Margin="0,5"/>
                            <TextBlock Text="Requieren intervención" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="8" Margin="0,0,12,0" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Prioridad Media (Amarillo)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="lblVulnerabilidadMedia" Text="0" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,5"/>
                            <TextBlock Text="En seguimiento" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="8" Margin="0,0,0,0" Padding="15" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Prioridad Baja (Verde)" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock x:Name="lblVulnerabilidadBaja" Text="0" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,5"/>
                            <TextBlock Text="Situación controlada" FontSize="11" Foreground="#10B981" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="8" Margin="0,0,15,0" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Distribución Numérica por Categoría" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>

                            <Grid Height="160" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                    <TextBlock x:Name="lblValorBarraRojo" Text="0" FontSize="11" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Border x:Name="barraRojo" Background="#EF4444" Width="45" Height="10" CornerRadius="4,4,0,0"/>
                                    <TextBlock Text="Rojo" FontSize="11" Foreground="#64748B" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                    <TextBlock x:Name="lblValorBarraAmarillo" Text="0" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Border x:Name="barraAmarillo" Background="#F59E0B" Width="45" Height="10" CornerRadius="4,4,0,0"/>
                                    <TextBlock Text="Amarillo" FontSize="11" Foreground="#64748B" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                    <TextBlock x:Name="lblValorBarraVerde" Text="0" FontSize="11" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <Border x:Name="barraVerde" Background="#10B981" Width="45" Height="10" CornerRadius="4,4,0,0"/>
                                    <TextBlock Text="Verde" FontSize="11" Foreground="#64748B" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Proporción de Criticidad" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

                            <Grid Height="120" Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="100" Height="100" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#E2E8F0" StrokeThickness="12" Width="90" Height="90"/>
                                    <!-- Los arcos de cada color se dibujan desde el código (DibujarDona) -->
                                    <Canvas x:Name="canvasDona" Width="100" Height="100"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblDonaTotal" Text="0" FontSize="16" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                                        <TextBlock Text="casos" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="10" Height="10" Fill="#EF4444"/>
                                        <TextBlock x:Name="txtPorcentajeRojo" Text="Alto: 0 (0%)" FontSize="12" Foreground="#1E293B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="10" Height="10" Fill="#F59E0B"/>
                                        <TextBlock x:Name="txtPorcentajeAmarillo" Text="Medio: 0 (0%)" FontSize="12" Foreground="#1E293B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="10" Height="10" Fill="#10B981"/>
                                        <TextBlock x:Name="txtPorcentajeVerde" Text="Bajo: 0 (0%)" FontSize="12" Foreground="#1E293B" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>