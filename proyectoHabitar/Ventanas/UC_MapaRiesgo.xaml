<UserControl x:Class="proyectoHabitar.Ventanas.UC_MapaRiesgo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fondo" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fondo" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TituloPanel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F6F8">
        <Grid Margin="25,20,25,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Encabezado -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Mapa de Riesgo" FontSize="24" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="lblResumen" Text="Cargando relevamientos..." FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnUbicarPendientes" Style="{StaticResource BotonAccion}" Background="#F59E0B" Content="📍 Ubicar pendientes"
                            Click="btnUbicarPendientes_Click" Visibility="Collapsed"
                            ToolTip="Busca en el mapa las direcciones de los relevamientos que todavía no tienen coordenadas."/>
                    <Button x:Name="btnRecargar" Style="{StaticResource BotonAccion}" Background="#334155" Content="🔄 Actualizar" Click="btnRecargar_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel lateral: filtros, zonas y casos críticos -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,15,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <TextBlock Text="PRIORIDAD VISIBLE" Style="{StaticResource TituloPanel}"/>
                            <CheckBox x:Name="chkRojo" IsChecked="True" Margin="0,0,0,6" Checked="Filtros_Changed" Unchecked="Filtros_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#EF4444" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="lblCantRojo" Text="Alta (Rojo)" FontSize="12"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="chkAmarillo" IsChecked="True" Margin="0,0,0,6" Checked="Filtros_Changed" Unchecked="Filtros_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#F59E0B" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="lblCantAmarillo" Text="Media (Amarillo)" FontSize="12"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox x:Name="chkVerde" IsChecked="True" Margin="0,0,0,15" Checked="Filtros_Changed" Unchecked="Filtros_Changed">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="11" Height="11" Fill="#10B981" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="lblCantVerde" Text="Baja (Verde)" FontSize="12"/>
                                </StackPanel>
                            </CheckBox>

                            <TextBlock Text="VISUALIZACIÓN" Style="{StaticResource TituloPanel}"/>
                            <RadioButton x:Name="rbAmbos" Content="Zonas de calor + familias" GroupName="modo" IsChecked="True" Margin="0,0,0,5" FontSize="12" Checked="Filtros_Changed"/>
                            <RadioButton x:Name="rbCalor" Content="Solo zonas críticas (calor)" GroupName="modo" Margin="0,0,0,5" FontSize="12" Checked="Filtros_Changed"/>
                            <RadioButton x:Name="rbMarcadores" Content="Solo familias (puntos)" GroupName="modo" Margin="0,0,0,15" FontSize="12" Checked="Filtros_Changed"/>

                            <TextBlock Text="ZONAS MÁS CRÍTICAS (por localidad)" Style="{StaticResource TituloPanel}"/>
                            <ListBox x:Name="lstZonas" BorderThickness="0" Margin="0,0,0,15" SelectionChanged="lstZonas_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,2">
                                            <TextBlock Text="{Binding Localidad}" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="#64748B">
                                                <Run Text="{Binding Rojos, Mode=OneWay}" Foreground="#EF4444" FontWeight="Bold"/><Run Text=" rojos · "/><Run Text="{Binding Total, Mode=OneWay}"/><Run Text=" casos · prom. "/><Run Text="{Binding Promedio, Mode=OneWay, StringFormat=N0}"/><Run Text=" pts"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="CASOS MÁS CRÍTICOS" Style="{StaticResource TituloPanel}"/>
                            <ListBox x:Name="lstCriticos" BorderThickness="0" SelectionChanged="lstCriticos_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="22" CornerRadius="4" Background="#FEE2E2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PuntajeCriticidad}" FontWeight="Bold" FontSize="11" Foreground="#B91C1C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Nombre}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Localidad}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Mapa -->
                <Border Grid.Column="1" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Background="White" ClipToBounds="True">
                    <Grid>
                        <wv2:WebView2 x:Name="webMapa" WebMessageReceived="webMapa_WebMessageReceived"/>
                        <StackPanel x:Name="panelCargandoMapa" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#3B82F6" Margin="0,0,0,10"/>
                            <TextBlock x:Name="lblEstadoMapa" Text="Cargando mapa..." Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
