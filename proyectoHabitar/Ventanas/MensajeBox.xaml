<Window x:Class="proyectoHabitar.Ventanas.MensajeBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HabitAR" Width="380" MinHeight="160" MaxHeight="620" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Border Background="#0f172a" CornerRadius="12" BorderBrush="#8f815e" BorderThickness="2">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblTitulo" Grid.Row="0" Text="Notificación"
                       FontSize="14" FontWeight="Bold" Foreground="#FAD70F"/>

            <Grid Grid.Row="1" Margin="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblIcono" Grid.Column="0" Text="⚠️" FontSize="24"
                           VerticalAlignment="Top" Margin="0,0,10,0" Foreground="#ff5a59"/>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                    <TextBlock x:Name="lblMensaje" Text="Contenido..."
                               FontSize="13" Foreground="White" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </ScrollViewer>
            </Grid>

            <!-- Solo visible en modo PedirTexto -->
            <TextBox x:Name="txtEntrada" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10" Height="60"
                     TextWrapping="Wrap" AcceptsReturn="False" VerticalContentAlignment="Top" Padding="5"
                     Background="#1E293B" Foreground="White" BorderBrush="#334155" CaretBrush="White"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="btnCancelar" Content="No" Width="75" Height="30" Margin="0,0,8,0"
                        Background="#334155" Foreground="White" Cursor="Hand" Visibility="Collapsed" Click="btnCancelar_Click">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnAceptar" Content="Aceptar" Width="75" Height="30"
                        Background="#3B82F6" Foreground="White" Cursor="Hand" Click="btnAceptar_Click">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
