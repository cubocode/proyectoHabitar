<Window x:Class="proyectoHabitar.Ventanas.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyectoHabitar.Ventanas"
        mc:Ignorable="d"
        Title="Login" Height="450" Width="381" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" WindowStyle="None">
    <Grid x:Name="FormLogin" HorizontalAlignment="Center" Width="381" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="txtUsuario" HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="196" TextChanged="TextBox_TextChanged" Height="31" Grid.Row="1"/>
        <TextBox x:Name="txtPassword" HorizontalAlignment="Center" Margin="0,46,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="196" TextChanged="TextBox_TextChanged" Height="31" Grid.Row="1"/>
        <Label x:Name="lblTitle" Content="INICIAR SESIÓN" HorizontalAlignment="Center" Height="31" Margin="0,145,0,0" VerticalAlignment="Top" Width="94"/>
        <Image HorizontalAlignment="Left" Height="89" Margin="153,40,0,0" VerticalAlignment="Top" Width="85" Source="/Ventanas/logo.png"/>
        <Button Content="Button" HorizontalAlignment="Center" Height="35" Margin="0,102,0,0" Grid.Row="1" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="btnIngresar" Content="Ingresar" HorizontalAlignment="Center" Height="35" Margin="0,102,0,0" Grid.Row="1" VerticalAlignment="Top" Width="120" Click="btnIngresar_Click"/>
        <Button x:Name="btnSalir" Content="Salir" HorizontalAlignment="Center" Height="35" Margin="0,142,0,0" Grid.Row="1" VerticalAlignment="Top" Width="120" Click="btnSalir_Click"/>
        <Button Content="Button" HorizontalAlignment="Left" Height="46" Margin="15,96,0,0" Grid.Row="1" VerticalAlignment="Top" Width="95"/>

    </Grid>
</Window>
