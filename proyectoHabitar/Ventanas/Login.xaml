<Window x:Class="proyectoHabitar.Ventanas.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:proyectoHabitar.Ventanas"
        mc:Ignorable="d"
        Title="HabitAR - Iniciar Sesión" Height="500" Width="400" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent">

    <Border Background="#1E293B" CornerRadius="15" BorderBrush="#334155" BorderThickness="1">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10,0,20">
                <Image Height="80" Width="80" Source="/Ventanas/logo.png" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="HabitAR" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Sistema de Gestión de Viviendas" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="10,0">

                <TextBlock Text="Usuario" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="#0F172A" CornerRadius="6" Padding="5" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,20">
                    <TextBox x:Name="txtUsuario" Background="Transparent" Foreground="White" BorderThickness="0" 
                             FontSize="14" VerticalContentAlignment="Center" Height="28" CaretBrush="White"/>
                </Border>

                <TextBlock Text="Contraseña" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="#0F172A" CornerRadius="6" Padding="5" BorderBrush="#334155" BorderThickness="1">
                    <PasswordBox x:Name="txtPassword" Background="Transparent" Foreground="White" BorderThickness="0" 
                                 FontSize="14" VerticalContentAlignment="Center" Height="28" CaretBrush="White"/>
                </Border>

            </StackPanel>

            <StackPanel Grid.Row="2" Margin="10,10,10,10">

                <Button x:Name="btnIngresar" Content="Ingresar" Height="40" Margin="0,0,0,12" Cursor="Hand" Click="btnIngresar_Click">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#3B82F6"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="btnSalir" Content="Salir" Height="35" Background="Transparent" Foreground="#94A3B8" Cursor="Hand" Click="btnSalir_Click">
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>
