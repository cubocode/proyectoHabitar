<Window x:Class="proyectoHabitar.Ventanas.Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HabitAR - Sistema de Gestión" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Storyboard x:Key="AbrirMenu">
            <DoubleAnimation Storyboard.TargetName="GridMenuLateral"
                             Storyboard.TargetProperty="Width"
                             From="60" To="250" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CerrarMenu">
            <DoubleAnimation Storyboard.TargetName="GridMenuLateral"
                             Storyboard.TargetProperty="Width"
                             From="250" To="60" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Background="#F5F6F8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="GridMenuLateral" Width="60" Background="#1E293B" HorizontalAlignment="Left" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button x:Name="btnToggleMenu" Grid.Row="0" Content="☰" 
                    FontSize="20" Background="Transparent" Foreground="White" BorderThickness="0"
                    HorizontalAlignment="Left" Width="60" Height="60" Click="btnToggleMenu_Click"/>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">

                <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="50" HorizontalContentAlignment="Left" Click="Menu_Dashboard_Click">
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Dashboard" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="50" HorizontalContentAlignment="Left" Click="Menu_Censos_Click">
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="📋" FontSize="20" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Beneficiarios" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="50" HorizontalContentAlignment="Left" Click="Menu_Mapa_Click">
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="🗺️" FontSize="20" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Opcion 3" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="50" HorizontalContentAlignment="Left" Click="Menu_Algoritmo_Click">
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Opcion 4" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Height="50" HorizontalContentAlignment="Left" Click="Menu_Configuracion_Click">
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                        <TextBlock Text="⚙️" FontSize="20" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Configuración" FontSize="14" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Margin="20">
            <ContentControl x:Name="PanelCentral">
                <TextBlock Text="Bienvenido a HabitAR. Seleccioná una opción del menú." 
                           FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#334155"/>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
    